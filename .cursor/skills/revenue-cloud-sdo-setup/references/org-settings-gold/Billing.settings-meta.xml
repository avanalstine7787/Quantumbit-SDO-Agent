<?xml version="1.0" encoding="UTF-8"?>
<BillingSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- EFM2 gold toggles. Omit org-specific record IDs and fields that require
         billing data / features not yet present (context mapping, DPE names,
         sequence services, ruleBasedCrAndPymtAppln). Add those after
         prepare_billing — see billing-guided-setup.md. -->
    <enableAutomaticRefunds>true</enableAutomaticRefunds>
    <enableBillingDisputeManagement>true</enableBillingDisputeManagement>
    <enableBillingSetup>true</enableBillingSetup>
    <enableConvertedCrMemoCrMemoLnAppln>true</enableConvertedCrMemoCrMemoLnAppln>
    <enableCrMemoApplicationToPostedInvoices>true</enableCrMemoApplicationToPostedInvoices>
    <enableDunningOrchestration>true</enableDunningOrchestration>
    <enableEnhancedPaymentData>true</enableEnhancedPaymentData>
    <enableFailedPaymentsRetry>true</enableFailedPaymentsRetry>
    <enableInvoiceEmailDelivery>true</enableInvoiceEmailDelivery>
    <enableInvoicePdfGeneration>true</enableInvoicePdfGeneration>
    <enableMilestoneBillingForAmend>true</enableMilestoneBillingForAmend>
    <enableNegInvoiceLnConversionToCrMemoLn>true</enableNegInvoiceLnConversionToCrMemoLn>
    <enablePaymentApplicationToPostedInvoices>true</enablePaymentApplicationToPostedInvoices>
    <enablePaymentSchedulesAndItemsCreation>true</enablePaymentSchedulesAndItemsCreation>
    <!-- Journal / FX toggles often reject until accounting prerequisites exist;
         deploy_org_settings_gold.py auto-omits on Metadata reject. Prefer leaving
         them out of the static gold for API 67 SDOs:
         enableTransactionJournalCreation, enableForeignExchangeTrxnJrnlCreation,
         enableTrxnAmountsStorageInCorpCurrency -->
    <enableTransactionsApplicationToInvoices>true</enableTransactionsApplicationToInvoices>
</BillingSettings>
